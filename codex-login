# ---------------------------------------------------------------------------
# Session-Log Scanner (Rate-Limits aus Codex JSONL-Dateien)
# ---------------------------------------------------------------------------

SESSION_TAIL_BYTES = 2 * 1024 * 1024
SESSION_SCAN_LIMIT = 50


def scan_session_limits(since: datetime | None = None) -> dict | None:
    if not SESSIONS_DIR.exists():
        return None
    files = sorted(
        (p for p in SESSIONS_DIR.rglob("*.jsonl") if p.is_file()),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )[:SESSION_SCAN_LIMIT]

    best: tuple[datetime, dict] | None = None
    for path in files:
        if since and datetime.fromtimestamp(path.stat().st_mtime, timezone.utc) < since:
            continue
        try:
            with path.open("rb") as fh:
                fh.seek(0, os.SEEK_END)
                fh.seek(max(0, fh.tell() - SESSION_TAIL_BYTES))
                raw = fh.read().decode("utf-8", errors="ignore")
        except OSError:
            continue
        for line in reversed(raw.splitlines()):
            if '"rate_limits"' not in line:
                continue
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = item.get("payload", {})
            rl      = payload.get("rate_limits") if isinstance(payload, dict) else None
            if not isinstance(rl, dict):
                continue
            ts_str = item.get("timestamp")
            try:
                ts = datetime.fromisoformat(ts_str.replace("Z", "+00:00")) if ts_str else None
            except Exception:
                ts = None
            ts = ts or datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)
            if since and ts <= since:
                break
            event = {"observed_at": ts.isoformat(), "rate_limits": rl}
            if best is None or ts > best[0]:
                best = (ts, event)
            break

    return best[1] if best else None

