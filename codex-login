def parse_codex_env(path: Path) -> list[dict[str, str]]:
    """Liest codex.env:
      email=user1@example.com
      email2=user2@example.com
      password=masterpassword
      workspace=business   # oder: personal
    """
    if not path.exists():
        raise SystemExit(
            f"codex.env nicht gefunden: {path}\n"
            "Format:\n"
            "  email=user1@example.com\n"
            "  email2=user2@example.com\n"
            "  password=masterpassword\n"
        )
    kv: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        kv[k.strip().lower()] = v.strip()

    password  = kv.get("password", "")
    workspace = kv.get("workspace", "business").lower()
    accounts: list[dict[str, str]] = []
    for key in sorted(kv):
        if not re.match(r'^email\d*$', key):
            continue
        e = kv[key].strip()
        if e:
            accounts.append({"email": e, "password": password, "workspace": workspace})
    return accounts


def pick_account(accounts: list[dict[str, str]]) -> dict[str, str]:
    if not accounts:
        raise SystemExit("Keine Accounts in codex.env gefunden.")
    state   = _load_state()
    current = state.get("current")
    print("\nVerfügbare Accounts:")
    for i, acc in enumerate(accounts, 1):
        e      = acc["email"]
        info   = _limit_display(state.get(e, {}))
        marker = " *" if e == current else ""
        print(f"  {i}.{marker} {e}{info}")
    raw = input("\nAuswahl (Nummer + Enter): ").strip()
    if raw.isdigit():
        idx = int(raw) - 1
        if not (0 <= idx < len(accounts)):
            raise SystemExit("Ungültige Nummer.")
        return accounts[idx]
    raise SystemExit("Bitte eine Zahl eingeben.")


def _pick_workspace(default: str, force_personal: bool) -> str:
    if force_personal:
        return "personal"
    label = "Personal" if default == "personal" else "Workspace"
    ans = input(f"Tenant [{label}]  w=Workspace  p=Personal  Enter=übernehmen: ").strip().lower()
    if ans == "p":
        return "personal"
    if ans == "w":
        return "business"
    return default

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

def _load_state() -> dict:
    if not STATE_PATH.exists():
        return {}
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {}


def _save_state(state: dict) -> None:
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    tmp.replace(STATE_PATH)


def _limit_display(account_state: dict) -> str:
    if not account_state:
        return ""
    last_login = account_state.get("last_login")
    limits     = account_state.get("limits")
    parts: list[str] = []
    if limits:
        primary = limits.get("primary") or {}
        used    = primary.get("used_percent")
        resets  = primary.get("resets_at")
        if isinstance(used, (int, float)):
            free = max(0.0, 100.0 - float(used))
            parts.append(f"5h {free:.0f}% frei")
            if isinstance(resets, (int, float)) and resets > now().timestamp():
                remaining = int((resets - now().timestamp()) / 60)
                h, m = divmod(remaining, 60)
                parts.append(f"reset in {h}h{m:02d}m" if h else f"reset in {m}m")
    if last_login and not parts:
        parts.append(f"Login: {last_login[:10]}")
    return f" [{', '.join(parts)}]" if parts else ""

# ---------------------------------------------------------------------------
# OAuth / Token-Refresh
# ---------------------------------------------------------------------------

def refresh_tokens(auth_path: Path) -> bool:
    try:
        data          = json.loads(auth_path.read_text(encoding="utf-8"))
        refresh_token = data.get("tokens", {}).get("refresh_token", "")
        if not refresh_token:
            return False
    except Exception:
        return False

    payload = urllib.parse.urlencode({
        "grant_type":    "refresh_token",
        "refresh_token": refresh_token,
        "client_id":     OAUTH_CLIENT_ID,
    }).encode()
    req = urllib.request.Request(
        OAUTH_TOKEN_URL, data=payload,
        headers={"Content-Type": "application/x-www-form-urlencoded"}, method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            result = json.loads(r.read())
    except Exception:
        return False

    if not result.get("access_token"):
        return False
    data["tokens"]["access_token"] = result["access_token"]
    if result.get("refresh_token"):
        data["tokens"]["refresh_token"] = result["refresh_token"]
    data["last_refresh"] = iso(now())
    _write_auth(auth_path, data)
    return True

# ---------------------------------------------------------------------------
# Auth-Datei schreiben
# ---------------------------------------------------------------------------

def _write_auth(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(path)
    try:
        os.chmod(path, 0o600)
    except PermissionError:
        pass

