# Login-Flow
# ---------------------------------------------------------------------------

def _start_codex_login() -> tuple[subprocess.Popen, str]:
    import shutil
    codex_bin = shutil.which("codex") or "/usr/local/bin/codex"
    CODEX_HOME.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    env["DISPLAY"] = ""

    proc = subprocess.Popen(
        [codex_bin, "login"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        env=env, text=True, bufsize=1,
    )

    url_re   = re.compile(r"https://auth\.openai\.com/oauth/authorize\S+")
    deadline = time.time() + 15
    authorize_url = ""
    while time.time() < deadline:
        line = proc.stdout.readline()  # type: ignore[union-attr]
        if not line and proc.poll() is not None:
            break
        m = url_re.search(line)
        if m:
            authorize_url = m.group(0)
            break

    if not authorize_url:
        proc.kill()
        raise SystemExit("Codex-Login hat keine Auth-URL ausgegeben.")
    return proc, authorize_url


def do_login(name: str, email: str, password: str, workspace: str = "business") -> int:
    try:
        from playwright.sync_api import TimeoutError as PWTimeout, sync_playwright
    except ImportError:
        raise SystemExit("Playwright fehlt: pip install playwright && playwright install chromium")

    print("  Starte codex login...")
    proc, authorize_url = _start_codex_login()

    if ACTIVE_AUTH.exists():
        ACTIVE_AUTH.unlink()
    auth_before = 0
    browser = None
    try:
        with sync_playwright() as pw:
            browser = pw.chromium.launch(
                headless=False,
                args=[
                    "--disable-blink-features=AutomationControlled",
                    "--no-sandbox",
                    "--disable-dev-shm-usage",
                ],
            )
            ctx = browser.new_context(
                user_agent=(
                    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                    "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
                ),
                viewport={"width": 1280, "height": 800},
                locale="de-DE",
            )
            ctx.add_init_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")
            page = ctx.new_page()
            page.goto(authorize_url, wait_until="domcontentloaded", timeout=30000)

            _wait_visible(page, ['input[name="username"]', 'input[type="email"]'], 30000).fill(email)
            _submit(page)

            pw_field = _wait_visible(page, ['input[name="password"]', 'input[type="password"]'], 30000)
            pw_field.fill(password)
            _submit(page, pw_field)

            otp_anchor   = None
            otp_required = False
            try:
                otp_anchor   = _wait_visible(page, ['input[name="code"]', 'input[autocomplete="one-time-code"]'], 8000)
                otp_required = True
            except PWTimeout:
                digits = page.locator('input[maxlength="1"], input[inputmode="numeric"]')
                try:
                    if digits.count() >= 6:
                        otp_required = True
                        otp_anchor   = digits.first
                except Exception:
                    pass

            if otp_required:
                if _imap_config():
                    print("  OTP nötig — rufe via IMAP ab...")
                    otp = _fetch_otp(wait=True)
                else:
                    print("  OTP nötig — kein IMAP konfiguriert (IMAP_HOST/IMAP_USER/IMAP_PASSWORD).")
                    otp = None
                if not otp:
                    otp = input("  OTP manuell eingeben: ").strip()
                if not re.fullmatch(r"\d{6}", otp or ""):
                    raise SystemExit("OTP fehlt oder ungültig.")

                otp_field = page.locator('input[name="code"], input[autocomplete="one-time-code"]').first
                try:
                    if otp_field.count() > 0:
                        otp_field.clear()
                        otp_field.fill(otp)
                    elif not _fill_otp(page, otp):
                        raise SystemExit("OTP-Eingabefeld nicht gefunden.")
                except Exception:
                    if not _fill_otp(page, otp):
                        raise SystemExit("OTP-Eingabefeld nicht gefunden.")
                _submit(page, otp_anchor)
                try:
                    page.wait_for_timeout(2000)
                    if page.locator(':text("Falscher Code"), :text("Invalid code")').count() > 0:
                        print("  OTP abgelehnt — bitte manuell eingeben:")
                        manual = input("  OTP manuell: ").strip()
                        if re.fullmatch(r"\d{6}", manual):
                            try:
                                f2 = page.locator('input[name="code"], input[autocomplete="one-time-code"]').first
                                f2.clear()
                                f2.fill(manual)
                            except Exception:
                                _fill_otp(page, manual)
                            _submit(page, otp_anchor)
                except Exception:
                    pass

            _handle_consent(page, workspace)

            print("  Warte auf OAuth-Callback...")
            deadline = time.time() + 30
            while time.time() < deadline:
                if ACTIVE_AUTH.exists() and ACTIVE_AUTH.stat().st_mtime > auth_before:
                    break
                if proc.poll() is not None:
                    break
                time.sleep(0.5)

    finally:
        if browser:
            try:
                browser.close()
            except Exception:
                pass
        try:
            proc.kill()
        except Exception:
            pass

    if not (ACTIVE_AUTH.exists() and ACTIVE_AUTH.stat().st_mtime > auth_before):
        time.sleep(2)
        if not (ACTIVE_AUTH.exists() and ACTIVE_AUTH.stat().st_mtime > auth_before):
            raise SystemExit("auth.json wurde nicht aktualisiert — Login fehlgeschlagen.")

    print(f"  Auth gespeichert: {ACTIVE_AUTH}")

    session_limits = scan_session_limits()
    state_data = _load_state()
    account_state: dict = {"email": email, "last_login": iso(now())}
    if session_limits:
        account_state["limits"]    = session_limits["rate_limits"]
        account_state["limits_at"] = session_limits["observed_at"]
    state_data[name]      = account_state
    state_data["current"] = name
    _save_state(state_data)

    if session_limits:
        rl   = session_limits.get("rate_limits") or {}
        p    = rl.get("primary") or {}
        used = p.get("used_percent")
        free = f"{max(0.0, 100.0 - float(used)):.0f}%" if isinstance(used, (int, float)) else "?"
        print(f"  Limits (aus Session-Log): 5h {free} frei")
    else:
        print("  Limits: noch keine Session-Log-Daten")

    print(f"\nOK — {name} eingeloggt.")
    return 0

