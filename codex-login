        print("1. Status anzeigen")
        print("2. Account einloggen")
        print("3. Alle Accounts einloggen")
        print("4. Token-Refresh")
        print("5. Beenden\n")
        try:
            choice = input("Auswahl [1]: ").strip() or "1"
        except (KeyboardInterrupt, EOFError):
            print("")
            return 0
        try:
            if   choice == "1": cmd_status(argparse.Namespace())
            elif choice == "2": cmd_login(argparse.Namespace(email=None, personal=False))
            elif choice == "3": cmd_login_all(argparse.Namespace())
            elif choice == "4": cmd_refresh(argparse.Namespace(name=None))
            elif choice == "5" or choice.lower() in {"q", "quit", "exit"}: return 0
            else: print("Ungültige Auswahl.")
        except (KeyboardInterrupt, EOFError):
            print("")
            return 0
        except SystemExit as exc:
            if exc.code:
                print(exc)


def main() -> int:
    if len(sys.argv) == 1:
        return interactive_menu()

    parser = argparse.ArgumentParser(
        prog="codex-login",
        description="ChatGPT OAuth-Login mit automatischem IMAP-OTP.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_login = sub.add_parser("login", help="Account einloggen (ohne Email: interaktive Auswahl).")
    p_login.add_argument("email", nargs="?", default=None)
    p_login.add_argument("-p", "--personal", action="store_true", help="Persönlichen Tenant verwenden.")
    p_login.set_defaults(func=cmd_login)

    p_all = sub.add_parser("login-all", help="Alle Accounts aus codex.env einloggen.")
    p_all.set_defaults(func=cmd_login_all)

    p_status = sub.add_parser("status", help="Login-Status und Limits anzeigen.")
    p_status.set_defaults(func=cmd_status)

    p_refresh = sub.add_parser("refresh", help="Access-Token für aktiven Account erneuern.")
    p_refresh.add_argument("name", nargs="?", default=None)
    p_refresh.set_defaults(func=cmd_refresh)

    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
