def cmd_login(args: argparse.Namespace) -> int:
    accounts = parse_codex_env(CODEX_ENV_PATH)
    if args.email:
        matches = [a for a in accounts if a["email"] == args.email]
        if not matches:
            raise SystemExit(f"Email '{args.email}' nicht in codex.env.")
        creds = matches[0]
    else:
        creds = pick_account(accounts)

    email    = creds["email"]
    password = creds.get("password", "").strip()
    if not password:
        raise SystemExit(f"Passwort für '{email}' fehlt.")
    workspace = _pick_workspace(creds.get("workspace", "business"), getattr(args, "personal", False))
    print(f"\nLogin: {email} (Tenant: {'Personal' if workspace == 'personal' else 'Workspace'})")
    return do_login(email, email, password, workspace)


def cmd_login_all(_: argparse.Namespace) -> int:
    accounts = parse_codex_env(CODEX_ENV_PATH)
    errors: list[str] = []
    for creds in accounts:
        email    = creds.get("email", "").strip()
        password = creds.get("password", "").strip()
        if not email or not password:
            print(f"\n[{email or '?'}] Übersprungen: Email oder Passwort fehlt.")
            errors.append(email or "?")
            continue
        print(f"\n{'='*50}\n{email}\n{'='*50}")
        try:
            rc = do_login(email, email, password, creds.get("workspace", "business"))
            if rc != 0:
                errors.append(email)
        except (SystemExit, Exception) as exc:
            print(f"[{email}] Fehler: {exc}")
            errors.append(email)

    total = len(accounts)
    print(f"\n{total - len(errors)}/{total} Accounts eingeloggt.")
    if errors:
        print(f"Fehler: {', '.join(errors)}")
    return 1 if errors else 0


def cmd_status(_: argparse.Namespace) -> int:
    state    = _load_state()
    accounts: list[dict[str, str]] = []
    try:
        accounts = parse_codex_env(CODEX_ENV_PATH)
    except SystemExit:
        pass

    current = state.get("current")
    if current and current in state:
        fresh = scan_session_limits()
        if fresh:
            state[current]["limits"]    = fresh["rate_limits"]
            state[current]["limits_at"] = fresh["observed_at"]
            _save_state(state)

    emails = [a["email"] for a in accounts] or [k for k in state if k != "current"]
    if not emails:
        print("Keine Accounts bekannt.")
        return 0

    print(f"Aktiv: {current or 'unbekannt'}")
    for e in emails:
        marker = " *" if e == current else "  "
        print(f"{marker}{e}{_limit_display(state.get(e, {}))}")
    return 0


def cmd_refresh(args: argparse.Namespace) -> int:
    state   = _load_state()
    current = args.name or state.get("current")
    if not current:
        raise SystemExit("Kein aktiver Account. Nutze: codex-login refresh NAME")
    print(f"Token-Refresh für '{current}'...", end=" ", flush=True)
    if refresh_tokens(ACTIVE_AUTH):
        print("OK")
        return 0
    print("Fehlgeschlagen.")
    return 1


def interactive_menu() -> int:
    while True:
