def _wait_visible(page: object, selectors: list[str], timeout: int) -> object:
    loc = page.locator(", ".join(selectors)).first
    loc.wait_for(state="visible", timeout=timeout)
    return loc


def _submit(page: object, field: object | None = None) -> None:
    for sel in [
        'button[type="submit"]',
        'button[data-action-button-primary="true"]',
        'button:has-text("Continue")',
        'button:has-text("Weiter")',
        'button:has-text("Verify")',
    ]:
        btn = page.locator(sel).first
        try:
            if btn.count() > 0:
                btn.click(timeout=2000)
                return
        except Exception:
            continue
    if field is not None:
        try:
            field.press("Enter")
            return
        except Exception:
            pass
    page.keyboard.press("Enter")


def _fill_otp(page: object, otp: str) -> bool:
    single = page.locator('input[name="code"], input[autocomplete="one-time-code"]').first
    try:
        if single.count() > 0:
            single.fill(otp)
            return True
    except Exception:
        pass
    digits = page.locator('input[maxlength="1"], input[inputmode="numeric"]')
    try:
        if digits.count() >= 6:
            try:
                digits.first.fill(otp)
                return True
            except Exception:
                for i, ch in enumerate(otp[:6]):
                    digits.nth(i).fill(ch)
                return True
    except Exception:
        pass
    return False

