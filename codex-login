# ---------------------------------------------------------------------------
# Zeit-Utilities
# ---------------------------------------------------------------------------

def now() -> datetime:
    return datetime.now(timezone.utc)

def iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")

# ---------------------------------------------------------------------------
# IMAP OTP-Abruf
# ---------------------------------------------------------------------------

def _imap_config() -> tuple[str, int, str, str] | None:
    host = os.environ.get("IMAP_HOST", "").strip()
    user = os.environ.get("IMAP_USER", "").strip()
    pw   = os.environ.get("IMAP_PASSWORD", "").strip()
    port = int(os.environ.get("IMAP_PORT", "993"))
    if not all([host, user, pw]):
        return None
    return host, port, user, pw


def _fetch_otp_imap() -> str | None:
    cfg = _imap_config()
    if not cfg:
        return None
    host, port, user, pw = cfg
    sender = os.environ.get("IMAP_OTP_SENDER", "openai.com").strip()
    print(f"  Verbinde mit IMAP {host}:{port}...")
    try:
        with imaplib.IMAP4_SSL(host, port) as mail:
            mail.login(user, pw)
            mail.select("INBOX")

            # Erst ungelesene suchen, dann alle
            for criteria in (("UNSEEN", "FROM", f'"{sender}"'), ("FROM", f'"{sender}"')):
                _, data = mail.search(None, *criteria)
                ids = data[0].split() if data[0] else []
                if ids:
                    break
            if not ids:
                print(f"  Keine E-Mail von '{sender}' im Posteingang.")
                return None

            _, msg_data = mail.fetch(ids[-1], "(RFC822)")
            raw = msg_data[0][1]
            msg = emaillib.message_from_bytes(raw)

            body = ""
            if msg.is_multipart():
                for part in msg.walk():
                    if part.get_content_type() == "text/plain":
                        try:
                            body += part.get_payload(decode=True).decode("utf-8", errors="ignore")
                        except Exception:
                            pass
            else:
                try:
                    body = msg.get_payload(decode=True).decode("utf-8", errors="ignore")
                except Exception:
                    body = str(msg.get_payload())

            # OTP extrahieren — Kontext-Match hat Vorrang
            m = re.search(
                r'(?:code|otp|verify|verification)[^\d]{0,60}(\d{6})'
                r'|(\d{6})[^\d]{0,40}(?:code|otp|expire)',
                body, re.IGNORECASE,
            )
            if m:
                print("  OTP gefunden (Kontext-Match).")
                return m.group(1) or m.group(2)

            m = re.search(r'^\s*(\d{6})\s*$', body, re.MULTILINE)
            if m:
                print("  OTP gefunden (Einzelzeile).")
                return m.group(1)

            print("  Kein OTP im E-Mail-Inhalt gefunden.")
    except imaplib.IMAP4.error as exc:
        print(f"  IMAP-Fehler: {exc}")
    except Exception as exc:
        print(f"  IMAP-Fehler: {exc}")
    return None


def _fetch_otp(wait: bool = True) -> str | None:
    if not _imap_config():
        return None
    if wait:
        print("  Warte 15s auf E-Mail-Zustellung...")
        time.sleep(15)
    otp = _fetch_otp_imap()
    if otp:
        return otp
    print("  Kein OTP — 10s warten und nochmal...")
    time.sleep(10)
    return _fetch_otp_imap()

